#!/usr/bin/env zsh
setopt errexit errreturn pipefail nounset

usage="
flash-ota [-h] <mode> [<dir>]
-h          help
--with-avb  don't set --disable-verity --disable-verification on the vbmeta flashes, and don't erase the vbmeta_* partitions.
-s <slot>   the slot to target
            is appended to partition name, so 'boot' becomes 'boot_<slot>'
<mode>      d for fastboot_d
            n for normal fastboot
<dir>       directory to use, defaults to cwd
"

zparseopts -D -F -- "h=arg_help" "s:=arg_slot" "-with-avb=arg_with_avb" || exit 1
if [[ -n "$arg_help" ]]; then
  echo "$usage"
  exit
fi

should_disable_avb=true
if [[ -n $arg_with_avb ]]; then
  should_disable_avb=
fi

slot_suffix=
if [[ -n "$arg_slot" ]]; then
  slot_suffix="_${arg_slot[2]}"
fi
mode="$1"
dir="${2:-$PWD}"

fastboot_parts=(
  dpm
  dtbo
  gz
  lk
  mcupm
  pi_img
  scp
  spmfw
  sspm
  tee
  vbmeta
  vbmeta_system
  vbmeta_vendor
)
fastboot_d_parts=(
  boot
  odm_dlkm
  preloader_raw
  product
  system
  vendor
  vendor_boot
  vendor_dlkm
)

if [[ "$mode" = d ]]; then
  echo "flashing fastboot d mode images"
  for part in ${fastboot_d_parts[@]}; do
    fastboot flash "$part$slot_suffix" "$dir/$part.img"
  done
elif [[ "$mode" = n ]]; then
  echo "flashing fastboot normal mode images"
  for part in ${fastboot_parts[@]}; do
    if [[ "$part" =~ vbmeta_ && $should_disable_avb ]]; then
      fastboot erase $part
    else
      should_add_disable_flags=
      if [[ "$part" = vbmeta && $should_disable_avb ]]; then
        should_add_disable_flags=true
      fi
      fastboot flash${should_add_disable_flags:+ --disable-verification --disable-verity} "$part$slot_suffix" "$dir/$part.img"
    fi
  done
else
  echo "mode $mode is not a valid mode"
  echo "$usage"
  exit 1
fi
